#!/usr/bin/python3
"""Browser-owned native messaging relay for OmaDeck Watch mode.

The process exists only while a Firefox or Chromium extension keeps its native
messaging port open. It carries bounded JSON frames over an owner-only Unix
socket and never prints browsing data or opens a TCP listener.
"""

import json
import os
import re
import selectors
import socket
import stat
import struct
import sys

MAX_MESSAGE = 1024
VIDEO_ID = re.compile(r"^[A-Za-z0-9_-]{11}$")


def valid_message(message, from_browser):
    if not isinstance(message, dict):
        return False
    kind = message.get("type")
    if from_browser and kind == "hello":
        return message.get("browser") in ("firefox", "chromium")
    if from_browser and kind == "clear":
        return True
    if from_browser and kind == "sourceClosed":
        tab_id = message.get("tabId")
        return (isinstance(tab_id, int) and not isinstance(tab_id, bool)
                and 0 <= tab_id <= 2147483647)
    if from_browser and kind == "candidate":
        seconds = message.get("seconds")
        tab_id = message.get("tabId")
        return (isinstance(message.get("videoId"), str)
                and VIDEO_ID.fullmatch(message["videoId"]) is not None
                and isinstance(seconds, (int, float)) and not isinstance(seconds, bool)
                and 0 <= seconds <= 604800
                and isinstance(tab_id, int) and not isinstance(tab_id, bool)
                and 0 <= tab_id <= 2147483647
                and isinstance(message.get("playing"), bool))
    if from_browser and kind == "ack":
        request_id = message.get("requestId")
        seconds = message.get("seconds", 0)
        return (isinstance(request_id, int) and not isinstance(request_id, bool)
                and 0 <= request_id <= 2147483647
                and isinstance(seconds, (int, float)) and not isinstance(seconds, bool)
                and 0 <= seconds <= 604800
                and isinstance(message.get("ok"), bool))
    if not from_browser and kind == "command":
        request_id = message.get("requestId")
        seconds = message.get("seconds")
        tab_id = message.get("tabId")
        return (message.get("action") in ("pause", "resume")
                and isinstance(request_id, int) and not isinstance(request_id, bool)
                and 0 <= request_id <= 2147483647
                and isinstance(tab_id, int) and not isinstance(tab_id, bool)
                and 0 <= tab_id <= 2147483647
                and isinstance(message.get("videoId"), str)
                and VIDEO_ID.fullmatch(message["videoId"]) is not None
                and isinstance(seconds, (int, float)) and not isinstance(seconds, bool)
                and 0 <= seconds <= 604800
                and isinstance(message.get("wasPlaying"), bool))
    return False


def encode(message):
    data = json.dumps(message, separators=(",", ":")).encode("utf-8")
    if len(data) > MAX_MESSAGE:
        raise ValueError("oversized message")
    return data


def write_all(fd, data):
    while data:
        count = os.write(fd, data)
        if count <= 0:
            raise OSError("short write")
        data = data[count:]


def main():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime:
        return 2
    info = os.lstat(runtime)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() \
            or info.st_mode & 0o022:
        return 2
    path = os.path.join(runtime, "omadeck-browser-watch.sock")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as deck:
        deck.connect(path)
        selector = selectors.DefaultSelector()
        selector.register(0, selectors.EVENT_READ)
        selector.register(deck, selectors.EVENT_READ)
        browser_data = bytearray()
        deck_data = bytearray()

        while True:
            for key, _ in selector.select():
                if key.fileobj == 0:
                    chunk = os.read(0, 4096)
                    if not chunk:
                        return 0
                    browser_data.extend(chunk)
                    if len(browser_data) > MAX_MESSAGE + 4096:
                        return 3
                    while len(browser_data) >= 4:
                        length = struct.unpack_from("<I", browser_data)[0]
                        if length == 0 or length > MAX_MESSAGE:
                            return 3
                        if len(browser_data) < 4 + length:
                            break
                        payload = bytes(browser_data[4:4 + length])
                        del browser_data[:4 + length]
                        try:
                            message = json.loads(payload)
                        except (UnicodeDecodeError, json.JSONDecodeError):
                            continue
                        if valid_message(message, True):
                            deck.sendall(encode(message) + b"\n")
                else:
                    chunk = deck.recv(4096)
                    if not chunk:
                        return 0
                    deck_data.extend(chunk)
                    if len(deck_data) > MAX_MESSAGE + 4096:
                        return 3
                    while b"\n" in deck_data:
                        raw, _, remainder = deck_data.partition(b"\n")
                        deck_data = bytearray(remainder)
                        if not raw or len(raw) > MAX_MESSAGE:
                            continue
                        try:
                            message = json.loads(raw)
                        except (UnicodeDecodeError, json.JSONDecodeError):
                            continue
                        if valid_message(message, False):
                            data = encode(message)
                            write_all(1, struct.pack("<I", len(data)) + data)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError):
        sys.exit(1)

#!/usr/bin/env bash

set -euo pipefail

entry_type=${1:-}
entry_value=${2:-}
[[ $entry_type == text || $entry_type == image ]] || exit 2
[[ -n $entry_value ]] || exit 2

history="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-history.json"
[[ -r $history ]] || exit 0

if [[ $entry_type == image ]]; then
  index=$(jq -r --arg value "$entry_value" 'map(.path == $value) | index(true) // empty' "$history")
else
  index=$(jq -r --arg value "$entry_value" 'map(.text == $value) | index(true) // empty' "$history")
fi
[[ $index =~ ^[0-9]+$ ]] || exit 0

entry_type=$(jq -r --argjson index "$index" '.[$index].type // ""' "$history")
entry_path=$(jq -r --argjson index "$index" '.[$index].path // ""' "$history")
temporary=$(mktemp "${history}.XXXXXX")
trap 'rm -f "$temporary"' EXIT
jq --argjson index "$index" 'del(.[$index])' "$history" > "$temporary"
chmod --reference="$history" "$temporary"
mv "$temporary" "$history"
trap - EXIT

images_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-images"
if [[ $entry_type == image && -n $entry_path && $entry_path == "$images_dir"/* && -f $entry_path ]]; then
  if ! jq -e --arg path "$entry_path" '.[] | select(.path == $path)' "$history" >/dev/null; then
    rm -- "$entry_path"
  fi
fi

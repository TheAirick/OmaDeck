#!/usr/bin/bash
set -uo pipefail
export PATH=/usr/bin:/usr/share/omarchy/bin

readonly PGREP=/usr/bin/pgrep
readonly HYPRCTL=/usr/bin/hyprctl
readonly JQ=/usr/bin/jq
readonly UDEVADM=/usr/bin/udevadm
readonly READLINK=/usr/bin/readlink
readonly SLEEP=/usr/bin/sleep
readonly SHA256SUM=/usr/bin/sha256sum
readonly WPCTL=/usr/bin/wpctl
readonly OMARCHY=/usr/share/omarchy/bin/omarchy
readonly OMARCHY_SHELL=/usr/share/omarchy/bin/omarchy-shell

script_path=${BASH_SOURCE[0]}
script_dir=$(cd -- "${script_path%/*}" && pwd)
plugin_dir=$(cd -- "$script_dir/.." && pwd)
target_screen=DP-3
primary_monitor=DP-1
custom_target_screen=false
custom_primary_monitor=false
summary_only=false
input_root=${OMADECK_INPUT_ROOT:-/dev/input}
proc_root=${OMADECK_PROC_ROOT:-/proc}
sys_input_root=${OMADECK_SYS_CLASS_INPUT_ROOT:-/sys/class/input}
touch_state_attempts=${OMADECK_TOUCH_STATE_ATTEMPTS:-4}
touch_state_retry_delay=${OMADECK_TOUCH_STATE_RETRY_DELAY:-0.1}
touch_device_names=(WCH.CN XENEON)
custom_touch_device_names=false

[[ $touch_state_attempts =~ ^[1-9][0-9]*$ ]] || touch_state_attempts=4
((touch_state_attempts <= 10)) || touch_state_attempts=10
case "$touch_state_retry_delay" in
  0|0.0|0.00|0.000|0.1|0.10|0.100|0.2|0.20|0.200|0.25|0.250) ;;
  *) touch_state_retry_delay=0.1 ;;
esac

while (($#)); do
  case "$1" in
    --summary)
      summary_only=true
      shift
      ;;
    --plugin-dir)
      plugin_dir=${2:?--plugin-dir requires a path}
      shift 2
      ;;
    --target-screen)
      target_screen=${2:?--target-screen requires a name}
      custom_target_screen=true
      shift 2
      ;;
    --primary-monitor)
      primary_monitor=${2:?--primary-monitor requires a name}
      custom_primary_monitor=true
      shift 2
      ;;
    --touch-device-name)
      if ! $custom_touch_device_names; then
        touch_device_names=()
        custom_touch_device_names=true
      fi
      touch_device_names+=("${2:?--touch-device-name requires a name}")
      shift 2
      ;;
    --no-touch-device)
      touch_device_names=()
      custom_touch_device_names=true
      shift
      ;;
    --help|-h)
      printf 'Usage: omadeck-doctor [--summary] [--plugin-dir PATH] [--target-screen NAME] [--primary-monitor NAME] [--touch-device-name NAME]... [--no-touch-device]\n'
      exit 0
      ;;
    *)
      printf 'Unknown option: %s\n' "$1" >&2
      exit 2
      ;;
  esac
done

# A direct invocation should diagnose the same persisted hardware selection as
# the live service. Explicit CLI arguments from the tray or a test remain
# authoritative, and an unavailable/older service falls back to safe defaults.
if [[ -x $OMARCHY_SHELL && -x $JQ ]]; then
  hardware_state=$("$OMARCHY_SHELL" pretty.omadeck hardwareState 2>/dev/null || true)
  if "$JQ" -e '
      type == "object" and .ok == true
      and (.targetScreen | type == "string" and length > 0 and length <= 128)
      and (.primaryMonitor | type == "string" and length > 0 and length <= 128)
      and (.touchDeviceNames | type == "array" and length > 0 and length <= 8
        and all(.[]; type == "string" and length > 0 and length <= 160))
    ' <<<"$hardware_state" >/dev/null 2>&1; then
    $custom_target_screen || target_screen=$("$JQ" -r '.targetScreen' <<<"$hardware_state")
    $custom_primary_monitor || primary_monitor=$("$JQ" -r '.primaryMonitor' <<<"$hardware_state")
    if ! $custom_touch_device_names; then
      mapfile -t touch_device_names < <("$JQ" -r '.touchDeviceNames[]' <<<"$hardware_state")
    fi
  fi
fi

declare -a report_lines=()
core_issues=0
advisories=0
touch_device=""
declare -a other_touch_devices=()
touch_open=false
touch_state=""
touch_state_device=""
touch_state_active=false
touch_state_exclusive=false
native_touch_built=false
[[ -f $plugin_dir/native/OmaDeck/Touch/libomadecktouchplugin.so ]] && native_touch_built=true

ok() {
  report_lines+=("[OK] $1")
}

fail() {
  report_lines+=("[FAIL] $1")
  ((core_issues += 1))
}

warn() {
  report_lines+=("[WARN] $1")
  ((advisories += 1))
}

touch_problem() {
  if $native_touch_built; then fail "$1"; else warn "$1 (native bridge is optional)"; fi
}

if [[ -x $PGREP ]] && "$PGREP" -x quickshell >/dev/null 2>&1; then
  ok "Omarchy shell is running"
else
  fail "Omarchy shell is not running"
fi

monitor_json=$([[ -x $HYPRCTL ]] && "$HYPRCTL" -j monitors 2>/dev/null || true)
if [[ -n $monitor_json && -x $JQ ]]; then
  if "$JQ" -e --arg name "$target_screen" 'any(.[]; .name == $name)' <<<"$monitor_json" >/dev/null 2>&1; then
    ok "Deck monitor $target_screen is connected"
  else
    fail "Deck monitor $target_screen is not connected"
  fi
  if "$JQ" -e --arg name "$primary_monitor" 'any(.[]; .name == $name)' <<<"$monitor_json" >/dev/null 2>&1; then
    ok "Primary monitor $primary_monitor is connected"
  else
    fail "Primary monitor $primary_monitor is not connected"
  fi
else
  fail "Could not inspect Hyprland monitors"
fi

for event_path in "$input_root"/event*; do
  [[ -e $event_path ]] || continue
  properties=$([[ -x $UDEVADM ]] && "$UDEVADM" info -q property -n "$event_path" 2>/dev/null || true)
  [[ $properties == *"ID_INPUT_TOUCHSCREEN=1"* ]] || continue
  event_name=${event_path##*/}
  device_name=""
  IFS= read -r device_name <"$sys_input_root/$event_name/device/name" 2>/dev/null || true
  matched_identity=false
  device_name_folded=${device_name,,}
  for touch_device_name in "${touch_device_names[@]}"; do
    if [[ $device_name_folded == *"${touch_device_name,,}"* ]]; then
      matched_identity=true
      break
    fi
  done
  if $matched_identity; then
    touch_device=$event_path
    break
  fi
  other_touch_devices+=("$event_path")
done

if ((${#touch_device_names[@]} == 0)); then
  touch_problem "No touchscreen identity is configured; OmaDeck will not grab any direct touchscreen"
elif [[ -n $touch_device ]]; then
  if [[ -r $touch_device ]]; then
    ok "Touchscreen is available and readable at $touch_device"
  else
    touch_problem "Touchscreen exists at $touch_device but is not readable"
  fi
elif ((${#other_touch_devices[@]} > 0)); then
  expected_names=$(IFS='/'; printf '%s' "${touch_device_names[*]}")
  touch_problem "Configured touchscreen is absent or mismatched (expected name containing $expected_names); found ${#other_touch_devices[@]} other direct touchscreen(s), which OmaDeck will not grab"
else
  expected_names=$(IFS='/'; printf '%s' "${touch_device_names[*]}")
  touch_problem "Configured touchscreen is absent (expected name containing $expected_names)"
fi

if [[ -n $touch_device ]]; then
  while IFS= read -r shell_pid; do
    for fd_path in "$proc_root/$shell_pid/fd/"*; do
      [[ -e $fd_path ]] || continue
      if [[ $("$READLINK" "$fd_path" 2>/dev/null || true) == "$touch_device" ]]; then
        touch_open=true
        break 2
      fi
    done
  done < <([[ -x $PGREP ]] && "$PGREP" -x quickshell 2>/dev/null || true)
fi

if $native_touch_built && [[ -x $OMARCHY_SHELL && -x $JQ ]]; then
  for ((attempt = 1; attempt <= touch_state_attempts; attempt++)); do
    touch_state=$("$OMARCHY_SHELL" pretty.omadeck touchState 2>/dev/null || true)
    if "$JQ" -e 'type == "object" and .active == true and .exclusiveGrab == true' \
        <<<"$touch_state" >/dev/null 2>&1; then
      break
    fi
    ((attempt == touch_state_attempts)) || "$SLEEP" "$touch_state_retry_delay"
  done
  if "$JQ" -e 'type == "object"' <<<"$touch_state" >/dev/null 2>&1; then
    touch_state_device=$("$JQ" -r '.devicePath // ""' <<<"$touch_state")
    [[ $("$JQ" -r '.active // false' <<<"$touch_state") == true ]] && touch_state_active=true
    [[ $("$JQ" -r '.exclusiveGrab // false' <<<"$touch_state") == true ]] && touch_state_exclusive=true
  fi
fi

if $native_touch_built && [[ -n $touch_device ]]; then
  if $touch_state_active && $touch_state_exclusive && [[ $touch_state_device == "$touch_device" ]]; then
    ok "OmaDeck touch bridge reports an active exclusive grab of $touch_device"
  elif $touch_open; then
    fail "Touchscreen $touch_device is open by Quickshell, but OmaDeck does not report an active exclusive grab"
  elif [[ -n $touch_state_device && $touch_state_device != "$touch_device" ]]; then
    fail "OmaDeck touch bridge reports a different device: $touch_state_device"
  else
    fail "OmaDeck touch bridge does not report an active exclusive grab of the touchscreen"
  fi
elif $native_touch_built && { $touch_state_active || [[ -n $touch_state_device ]]; }; then
  fail "OmaDeck touch bridge reports an active device that does not match the configured touchscreen: $touch_state_device"
fi

if $native_touch_built; then
  ok "Native touch bridge is built"
else
  warn "Native touch bridge is not built; using compositor-managed input"
fi

if [[ -x $plugin_dir/native/bin/omadeck-tray ]]; then
  ok "System-tray controller is built"
  if [[ -f $plugin_dir/native/artifacts.sha256 && ! -L $plugin_dir/native/artifacts.sha256 ]] \
    && [[ -x $SHA256SUM ]] \
    && (cd "$plugin_dir/native" && "$SHA256SUM" -c artifacts.sha256 --status); then
    ok "Native artifact integrity record matches the installed binaries"
  else
    warn "Native artifact integrity record is missing or stale; run scripts/build-native"
  fi
else
  warn "System-tray controller is not built; run scripts/build-native"
fi

for command_path in \
  "$HOME/.local/bin/alienware-to-omarchy" \
  "$HOME/.local/bin/alienware-to-mac"; do
  if [[ -x $command_path ]]; then
    ok "Monitor input command is executable: $command_path"
  else
    warn "Monitor input command is missing or not executable: $command_path"
  fi
done

required_names=(hyprctl jq omarchy omarchy-shell wpctl)
required_paths=("$HYPRCTL" "$JQ" "$OMARCHY" "$OMARCHY_SHELL" "$WPCTL")
for index in "${!required_names[@]}"; do
  if [[ -f ${required_paths[$index]} && -x ${required_paths[$index]} ]]; then
    ok "Required command is available: ${required_names[$index]}"
  else
    fail "Required command is missing: ${required_names[$index]}"
  fi
done

if $summary_only; then
  if ((core_issues == 0)); then
    if ((advisories == 0)); then
      printf 'Healthy — touchscreen connected\n'
    else
      printf 'Healthy — %d advisor%s\n' "$advisories" "$([[ $advisories -eq 1 ]] && printf y || printf ies)"
    fi
  else
    printf 'Attention — %d health issue%s\n' "$core_issues" "$([[ $core_issues -eq 1 ]] || printf s)"
  fi
  ((core_issues == 0)) && exit 0
  exit 1
fi

printf 'OmaDeck diagnostics\n'
printf 'Plugin: %s\n' "$plugin_dir"
printf 'Deck monitor: %s    Primary monitor: %s\n\n' "$target_screen" "$primary_monitor"
printf '%s\n' "${report_lines[@]}"
printf '\n'
if ((core_issues == 0)); then
  printf 'Overall: healthy'
  ((advisories == 0)) || printf ' with %d advisory item(s)' "$advisories"
  printf '\n'
else
  printf 'Overall: attention required (%d health issue(s), %d advisory item(s))\n' "$core_issues" "$advisories"
fi

((core_issues == 0)) && exit 0
exit 1

#!/usr/bin/python3

"""Emit one bounded OmaDeck system snapshot.

Every external producer has a byte limit, deadline, and process-group cleanup.
Cross-run counters use descriptor-relative, no-follow I/O in a private runtime
directory so predictable state names cannot be redirected through symlinks.
"""

from __future__ import annotations

import fcntl
import json
import math
import os
import re
import secrets
import selectors
import signal
import stat
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


UID = os.getuid()
DIRECTORY_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
FILE_FLAGS = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW
MAX_CLIENTS = 64
MAX_CLIPBOARD_ITEMS = 20
MAX_OUTPUT_BYTES = 256 * 1024
os.environ["PATH"] = "/usr/bin:/usr/share/omarchy/bin"
SENSORS = "/usr/bin/sensors"
NVIDIA_SMI = "/usr/bin/nvidia-smi"
IP = "/usr/bin/ip"
HYPRCTL = "/usr/bin/hyprctl"
PS = "/usr/bin/ps"


def trusted_executable(path: str) -> bool:
    """Accept only root-owned, non-writable executables at fixed paths."""
    if not os.path.isabs(path):
        return False
    try:
        metadata = os.stat(path)
        return (
            stat.S_ISREG(metadata.st_mode)
            and metadata.st_uid == 0
            and not stat.S_IMODE(metadata.st_mode) & 0o022
            and os.access(path, os.X_OK)
        )
    except OSError:
        return False


def checked_directory(path: str) -> int:
    """Open an absolute directory through a validated, no-follow parent chain."""
    if not os.path.isabs(path):
        raise RuntimeError("runtime directory must be absolute")

    descriptor = os.open("/", DIRECTORY_FLAGS)
    try:
        for component in Path(path).parts[1:]:
            next_descriptor = os.open(component, DIRECTORY_FLAGS, dir_fd=descriptor)
            metadata = os.fstat(next_descriptor)
            mode = stat.S_IMODE(metadata.st_mode)
            writable = mode & 0o022
            sticky_root = metadata.st_uid == 0 and bool(mode & stat.S_ISVTX)
            if metadata.st_uid not in (0, UID) or (writable and not sticky_root):
                os.close(next_descriptor)
                raise RuntimeError(f"unsafe runtime parent: {path}")
            os.close(descriptor)
            descriptor = next_descriptor
        return descriptor
    except Exception:
        os.close(descriptor)
        raise


def private_state_directory() -> tuple[int, int]:
    base_path = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    base_descriptor = checked_directory(base_path)
    state_descriptor = -1
    try:
        try:
            os.mkdir("omadeck-system", mode=0o700, dir_fd=base_descriptor)
        except FileExistsError:
            pass
        state_descriptor = os.open("omadeck-system", DIRECTORY_FLAGS, dir_fd=base_descriptor)
        metadata = os.fstat(state_descriptor)
        if metadata.st_uid != UID:
            raise RuntimeError("OmaDeck runtime state must be owned by the current user")
        os.fchmod(state_descriptor, 0o700)
        if stat.S_IMODE(os.fstat(state_descriptor).st_mode) != 0o700:
            raise RuntimeError("OmaDeck runtime state must use mode 0700")

        lock_descriptor = os.open(
            "state.lock",
            os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW,
            0o600,
            dir_fd=state_descriptor,
        )
        lock_metadata = os.fstat(lock_descriptor)
        if (
            not stat.S_ISREG(lock_metadata.st_mode)
            or lock_metadata.st_uid != UID
            or lock_metadata.st_nlink != 1
            or stat.S_IMODE(lock_metadata.st_mode) & 0o022
        ):
            os.close(lock_descriptor)
            raise RuntimeError("unsafe OmaDeck runtime lock")
        os.fchmod(lock_descriptor, 0o600)
        fcntl.flock(lock_descriptor, fcntl.LOCK_EX)
        return state_descriptor, lock_descriptor
    except Exception:
        if state_descriptor >= 0:
            os.close(state_descriptor)
        raise
    finally:
        os.close(base_descriptor)


def read_state(directory: int, name: str, limit: int = 256) -> str:
    try:
        descriptor = os.open(name, FILE_FLAGS, dir_fd=directory)
    except FileNotFoundError:
        return ""
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != UID
            or stat.S_IMODE(metadata.st_mode) & 0o022
            or metadata.st_size > limit
        ):
            return ""
        data = os.read(descriptor, limit + 1)
        return data.decode("ascii", "strict") if len(data) <= limit else ""
    except (OSError, UnicodeError):
        return ""
    finally:
        os.close(descriptor)


def write_state(directory: int, name: str, value: str) -> None:
    payload = value.encode("ascii", "strict")
    if len(payload) > 256:
        raise RuntimeError("state payload exceeds limit")
    temporary = f".{name}.{os.getpid()}.{secrets.token_hex(8)}"
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o600,
        dir_fd=directory,
    )
    try:
        offset = 0
        while offset < len(payload):
            offset += os.write(descriptor, payload[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
    os.fsync(directory)


def terminate_group(process: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass


def run_bounded(arguments: list[str], max_bytes: int, timeout: float) -> bytes:
    """Read a producer incrementally and kill its whole group on limit/deadline."""
    if not arguments or not trusted_executable(arguments[0]):
        return b""
    try:
        process = subprocess.Popen(
            arguments,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            close_fds=True,
        )
    except (FileNotFoundError, PermissionError, OSError):
        return b""

    assert process.stdout is not None
    descriptor = process.stdout.fileno()
    os.set_blocking(descriptor, False)
    selector = selectors.DefaultSelector()
    selector.register(descriptor, selectors.EVENT_READ)
    output = bytearray()
    deadline = time.monotonic() + timeout
    exceeded = False
    eof = False
    try:
        while not eof:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                exceeded = True
                break
            events = selector.select(min(remaining, 0.1))
            for key, _ in events:
                chunk = os.read(key.fd, min(65536, max_bytes - len(output) + 1))
                if not chunk:
                    eof = True
                    break
                output.extend(chunk)
                if len(output) > max_bytes:
                    exceeded = True
                    eof = True
                    break
        if exceeded:
            terminate_group(process)
        try:
            return_code = process.wait(timeout=0.5)
        except subprocess.TimeoutExpired:
            terminate_group(process)
            return_code = process.wait(timeout=0.5)
        if exceeded or return_code != 0:
            return b""
        return bytes(output)
    finally:
        selector.close()
        process.stdout.close()
        if process.poll() is None:
            terminate_group(process)
            process.wait(timeout=0.5)


def read_file(path: str, limit: int, *, require_owner: bool = False) -> bytes:
    try:
        descriptor = os.open(path, FILE_FLAGS)
    except (FileNotFoundError, PermissionError, OSError):
        return b""
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode):
            return b""
        if require_owner and (metadata.st_uid != UID or stat.S_IMODE(metadata.st_mode) & 0o022):
            return b""
        if metadata.st_size > limit:
            return b""
        output = bytearray()
        while len(output) <= limit:
            chunk = os.read(descriptor, min(16384, limit - len(output) + 1))
            if not chunk:
                break
            output.extend(chunk)
        return bytes(output) if len(output) <= limit else b""
    finally:
        os.close(descriptor)


def finite_number(value: Any, default: float = 0.0) -> float:
    try:
        number = float(value)
        return number if math.isfinite(number) else default
    except (TypeError, ValueError):
        return default


def bounded_string(value: Any, limit: int = 256) -> str:
    return str(value or "")[:limit]


def sanitize(value: Any, depth: int = 0) -> Any:
    if depth > 4:
        return None
    if isinstance(value, str):
        return value[:2048]
    if isinstance(value, bool) or value is None:
        return value
    if isinstance(value, (int, float)):
        return value if not isinstance(value, float) or math.isfinite(value) else 0
    if isinstance(value, list):
        return [sanitize(item, depth + 1) for item in value[:32]]
    if isinstance(value, dict):
        return {
            bounded_string(key, 64): sanitize(item, depth + 1)
            for key, item in list(value.items())[:32]
        }
    return bounded_string(value)


def cpu_snapshot(state_directory: int) -> int:
    lines = read_file("/proc/stat", 64 * 1024).decode("ascii", "ignore").splitlines()
    if not lines:
        return 0
    values = [int(value) for value in lines[0].split()[1:11]]
    total = sum(values)
    idle = values[3] + (values[4] if len(values) > 4 else 0)
    percent = 0
    previous = read_state(state_directory, "cpu").split()
    if len(previous) == 2 and all(part.isdigit() for part in previous):
        old_total, old_idle = map(int, previous)
        delta_total = total - old_total
        delta_idle = idle - old_idle
        if delta_total > 0:
            percent = max(0, min(100, round(100 * (delta_total - delta_idle) / delta_total)))
    write_state(state_directory, "cpu", f"{total} {idle}\n")
    return percent


def memory_snapshot() -> tuple[int, int, int]:
    values: dict[str, int] = {}
    for line in read_file("/proc/meminfo", 64 * 1024).decode("ascii", "ignore").splitlines():
        fields = line.replace(":", "").split()
        if len(fields) >= 2 and fields[0] in ("MemTotal", "MemAvailable"):
            values[fields[0]] = int(fields[1]) * 1024
    total = values.get("MemTotal", 0)
    used = max(0, total - values.get("MemAvailable", total))
    percent = round(100 * used / total) if total else 0
    return percent, used, total


def temperature_snapshot() -> str:
    output = run_bounded([SENSORS, "-u"], 64 * 1024, 1.5).decode("utf-8", "replace")
    match = re.search(r"(?:Tctl|temp1)_input:\s*([+-]?[0-9]+(?:\.[0-9]+)?)", output)
    return str(round(float(match.group(1)))) if match else ""


def gpu_snapshot() -> tuple[str, str, str, str]:
    output = run_bounded(
        [
            NVIDIA_SMI,
            "--query-gpu=utilization.gpu,temperature.gpu,memory.used,memory.total",
            "--format=csv,noheader,nounits",
        ],
        4096,
        1.5,
    ).decode("ascii", "ignore").splitlines()
    if not output:
        return "", "", "", ""
    fields = [field.strip() for field in output[0].split(",")[:4]]
    fields.extend([""] * (4 - len(fields)))
    return fields[0], fields[1], fields[2], fields[3]


def network_snapshot(state_directory: int) -> tuple[str, int, int]:
    output = run_bounded([IP, "route", "show", "default"], 16 * 1024, 1.0)
    interface = ""
    fields = output.decode("utf-8", "replace").split()
    if "dev" in fields and fields.index("dev") + 1 < len(fields):
        candidate = fields[fields.index("dev") + 1]
        if re.fullmatch(r"[A-Za-z0-9_.:-]{1,64}", candidate):
            interface = candidate
    if not interface:
        return "", 0, 0

    rx_data = read_file(f"/sys/class/net/{interface}/statistics/rx_bytes", 64)
    tx_data = read_file(f"/sys/class/net/{interface}/statistics/tx_bytes", 64)
    try:
        rx = int(rx_data)
        tx = int(tx_data)
    except ValueError:
        return interface, 0, 0

    now = int(time.monotonic())
    down = up = 0
    previous = read_state(state_directory, "network").split()
    if len(previous) == 3 and all(part.isdigit() for part in previous):
        old_time, old_rx, old_tx = map(int, previous)
        elapsed = now - old_time
        if elapsed > 0:
            down = max(0, (rx - old_rx) // elapsed)
            up = max(0, (tx - old_tx) // elapsed)
    write_state(state_directory, "network", f"{now} {rx} {tx}\n")
    return interface, down, up


def storage_snapshot() -> dict[str, int]:
    filesystem = os.statvfs("/")
    total = filesystem.f_blocks * filesystem.f_frsize
    free = filesystem.f_bavail * filesystem.f_frsize
    used = max(0, total - free)
    return {"used": used, "total": total, "free": free, "percent": round(100 * used / total) if total else 0}


def client_snapshot() -> list[dict[str, Any]]:
    raw = run_bounded([HYPRCTL, "clients", "-j"], 1024 * 1024, 2.0)
    try:
        decoded = json.loads(raw) if raw else []
    except json.JSONDecodeError:
        decoded = []
    if not isinstance(decoded, list):
        return []

    clients: list[dict[str, Any]] = []
    pids: list[int] = []
    for item in decoded[:MAX_CLIENTS]:
        if not isinstance(item, dict):
            continue
        workspace = item.get("workspace") if isinstance(item.get("workspace"), dict) else {}
        try:
            pid = int(item.get("pid") or 0)
            workspace_id = int(workspace.get("id") or 0)
            monitor = int(item.get("monitor") or 0)
        except (TypeError, ValueError):
            continue
        client = {
            "address": bounded_string(item.get("address"), 96),
            "title": bounded_string(item.get("title"), 512),
            "class": bounded_string(item.get("class"), 256),
            "pid": pid,
            "workspace": workspace_id,
            "workspaceName": bounded_string(workspace.get("name"), 128),
            "monitor": monitor,
            "cpu": 0,
            "memory": 0,
            "rss": 0,
            "state": "?",
            "elapsed": 0,
        }
        clients.append(client)
        if pid > 0:
            pids.append(pid)

    if pids:
        process_output = run_bounded(
            [PS, "-p", ",".join(map(str, pids)), "-o", "pid=,%cpu=,%mem=,rss=,stat=,etimes="],
            64 * 1024,
            2.0,
        ).decode("ascii", "ignore")
        process_map: dict[int, tuple[float, float, int, str, int]] = {}
        for line in process_output.splitlines()[:MAX_CLIENTS]:
            fields = line.split()
            if len(fields) < 6 or not fields[0].isdigit():
                continue
            process_map[int(fields[0])] = (
                finite_number(fields[1]),
                finite_number(fields[2]),
                max(0, int(finite_number(fields[3]))) * 1024,
                bounded_string(fields[4], 16),
                max(0, int(finite_number(fields[5]))),
            )
        for client in clients:
            process_values = process_map.get(client["pid"])
            if process_values:
                client["cpu"], client["memory"], client["rss"], client["state"], client["elapsed"] = process_values
    return sorted(clients, key=lambda item: (item["workspace"], item["class"]))


def clipboard_snapshot() -> list[Any]:
    state_home = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
    path = os.path.join(state_home, "omarchy", "clipboard-history.json")
    raw = read_file(path, 1024 * 1024, require_owner=True)
    try:
        decoded = json.loads(raw) if raw else []
    except json.JSONDecodeError:
        return []
    # Omarchy 4 stores newest-first clipboard history as a JSON array. Keep the
    # source index so a displayed entry can be removed from the authoritative
    # in-shell model without comparing or exposing clipboard contents.
    entries = list(enumerate(decoded[:MAX_CLIPBOARD_ITEMS])) if isinstance(decoded, list) else []
    output = []
    for index, value in entries:
        item = sanitize(value)
        if isinstance(item, dict):
            item["historyIndex"] = index
            output.append(item)
    return output


def main() -> int:
    state_directory, lock_descriptor = private_state_directory()
    try:
        cpu_percent = cpu_snapshot(state_directory)
        memory_percent, memory_used, memory_total = memory_snapshot()
        cpu_temperature = temperature_snapshot()
        gpu_percent, gpu_temperature, gpu_used, gpu_total = gpu_snapshot()
        interface, download, upload = network_snapshot(state_directory)
        snapshot = {
            "performance": {
                "cpu": cpu_percent,
                "memory": memory_percent,
                "memoryUsed": memory_used,
                "memoryTotal": memory_total,
                "cpuTemp": cpu_temperature,
                "gpu": gpu_percent,
                "gpuTemp": gpu_temperature,
                "gpuUsed": gpu_used,
                "gpuTotal": gpu_total,
            },
            "network": {"interface": interface, "down": download, "up": upload},
            "storage": storage_snapshot(),
            "clients": client_snapshot(),
            "clipboard": clipboard_snapshot(),
        }
        payload = json.dumps(snapshot, ensure_ascii=True, separators=(",", ":")).encode("utf-8")
        if len(payload) > MAX_OUTPUT_BYTES:
            raise RuntimeError("system snapshot exceeds output limit")
        sys.stdout.buffer.write(payload + b"\n")
        return 0
    finally:
        os.close(lock_descriptor)
        os.close(state_directory)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as error:
        print(f"OmaDeck system stats unavailable: {error}", file=sys.stderr)
        raise SystemExit(1)

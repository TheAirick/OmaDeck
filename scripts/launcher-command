#!/usr/bin/python3
"""Launch an explicitly saved OmaDeck command in its own application scope."""
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys


def read_command(filename, entry_id):
    if not re.fullmatch(r'custom:[a-z0-9-]{1,64}', entry_id):
        raise ValueError('Invalid button')
    descriptor = os.open(filename, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    with os.fdopen(descriptor, 'rb') as stream:
        meta = os.fstat(stream.fileno())
        if not stat.S_ISREG(meta.st_mode) or meta.st_uid != os.getuid() or meta.st_mode & 0o022 or meta.st_size > 4 * 1024 * 1024:
            raise ValueError('Invalid settings')
        raw = stream.read(4 * 1024 * 1024 + 1)
        if len(raw) > 4 * 1024 * 1024:
            raise ValueError('Settings too large')
    settings = json.loads(raw)
    if settings.get('version') != 2 or entry_id not in settings.get('entries', []):
        raise ValueError('Button is not saved')
    for entry in settings.get('custom', [])[:128]:
        if entry.get('id') == entry_id:
            command = entry.get('command')
            if not isinstance(command, str) or not command.strip() or len(command) > 4096 or '\x00' in command:
                raise ValueError('Invalid command')
            directory = entry.get('directory', '')
            if not isinstance(directory, str) or len(directory) > 1024 or any(ord(c) < 32 for c in directory):
                raise ValueError('Invalid folder')
            return entry
    raise ValueError('Button is missing')


def launch(entry):
    directory = str(Path(entry.get('directory') or '~').expanduser())
    if not os.path.isabs(directory) or not os.path.isdir(directory):
        raise ValueError('Working folder unavailable')
    argv = ['/usr/bin/uwsm-app', '--']
    if entry.get('terminal') is True:
        argv += ['/usr/bin/xdg-terminal-exec', '--dir=' + directory]
    argv += ['/usr/bin/bash', '-c', entry['command']]
    for executable in ['/usr/bin/uwsm-app', '/usr/bin/bash'] + (['/usr/bin/xdg-terminal-exec'] if entry.get('terminal') is True else []):
        if not os.access(executable, os.X_OK):
            raise ValueError('Launcher unavailable')
    # This is the user's job, not a keep-loaded helper. It has its own session,
    # no inherited touch descriptors, and no arbitrary execution deadline.
    process = subprocess.Popen(argv, cwd=directory, stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, close_fds=True, start_new_session=True)
    try:
        if process.wait(timeout=0.2) != 0:
            raise RuntimeError('Launch failed')
    except subprocess.TimeoutExpired:
        pass


if __name__ == '__main__':
    try:
        if len(sys.argv) != 3:
            raise ValueError('Expected saved button')
        launch(read_command(sys.argv[1], sys.argv[2]))
    except (OSError, ValueError, TypeError, KeyError, AttributeError, RuntimeError):
        sys.exit(1)
